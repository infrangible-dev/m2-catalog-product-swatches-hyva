{
    "require": [
        "{{{1200128_anodosys}}}/webserver_php_magento-module-demo.json",
        "{{{1200128_anodosys}}}/database_magento2-module-demo.json",
        "{{{1200128_anodosys}}}/elasticsearch_magento-module-demo.json",
        "{{{1200128_anodosys}}}/mailcatcher_magento.json",
        "{{{1200128_anodosys}}}/magento2-module-demo-hyva.json"
    ],
    "global": {
        "systemName": "infrangible_m2_catalog_product_swatches_hyva"
    },
    "ws": {
        "webServerType": "apache_php",
        "webServerVersion": "2.4",
        "phpVersion": "8.2",
        "containerVolumes": [
            "{configPath}/../src:/var/www/magento/htdocs/app/code/Infrangible/CatalogProductSwatchesHyva:www-data"
        ]
    },
    "db": {
        "databaseType": "mysql",
        "databaseVersion": "5.7"
    },
    "es": {
        "elasticsearchVersion": "7.9"
    },
    "mc": {
        "mailCatcherVersion": "0.6"
    },
    "ms": {
        "magentoVersion": "2.4.6-p3",
        "magentoEdition": "community"
    }
}
