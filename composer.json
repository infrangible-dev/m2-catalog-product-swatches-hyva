{
    "name": "infrangible/m2-catalog-product-swatches-hyva",
    "description": "Provides the groundwork of Catalog Product Swatches in stores using the Hyvä theme, so variant-specific information can be shown on configurable product pages.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Hyvä",
        "Catalog"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-swatches-hyva",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-catalog-product-swatches": "~1.1.0",
        "hyva-themes/magento2-compat-module-fallback": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductSwatchesHyva\\": "src"
        }
    }
}
